# ShopSense AI - Environment Configuration Template
# Copy this file to .env and configure local settings if required.

# Server Settings
APP_ENV=development
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

# Model & Data Paths
MODEL_PATH=models/best_model.joblib
RAW_DATA_PATH=data/raw/online_shoppers_intention.csv
PROCESSED_DATA_DIR=data/processed

# Logging
LOG_LEVEL=INFO
